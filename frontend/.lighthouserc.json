{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/privacy/",
        "http://localhost:3000/terms/",
        "http://localhost:3000/security/",
        "http://localhost:3000/security/vdp/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": [
          "--no-sandbox",
          "--disable-gpu"
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.90
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    }
  }
}
